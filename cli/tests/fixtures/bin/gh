#!/usr/bin/env python3
# Rules: $FAKE_GH_DIR/responses.json, a list of
#   { "match": ["substring of argv or stdin", ...], "body": <json> | "raw": "text", "stderr": "", "exit": n, "sleep": seconds,
#     "run": [argv] }
# "run" is executed before answering, to change the state dir while reviewkit waits on gh.
# First rule whose every match is found wins; calls go to calls.jsonl.
# Without FAKE_GH_DIR only --version and `auth token` are answered.
import json
import os
import subprocess
import sys
import time

args = sys.argv[1:]
joined = " ".join(args)
stdin = "" if sys.stdin.isatty() else sys.stdin.read()
fake_dir = os.environ.get("FAKE_GH_DIR")

PINNED = ["CLICOLOR_FORCE", "GH_FORCE_TTY", "NO_COLOR", "GH_PROMPT_DISABLED"]

if fake_dir:
    with open(os.path.join(fake_dir, "calls.jsonl"), "a") as log:
        env = {k: os.environ[k] for k in PINNED if k in os.environ}
        log.write(json.dumps({"args": args, "stdin": stdin, "env": env}) + "\n")


def emit(text):
    # Like gh: forcing colour colours JSON even when stdout is a pipe.
    if os.environ.get("CLICOLOR_FORCE", "0") != "0" or os.environ.get("GH_FORCE_TTY"):
        text = "\x1b[1;38m" + text + "\x1b[m"
    sys.stdout.write(text)


if args[:1] == ["--version"]:
    emit("gh version 0.0.0-fake\n")
    sys.exit(0)
if args[:2] == ["auth", "token"]:
    if os.environ.get("GH_FAKE_AUTH", "1") == "0":
        sys.stderr.write("no oauth token found for github.com\n")
        sys.exit(1)
    print("gho_fake")
    sys.exit(0)

rules = []
if fake_dir and os.path.exists(os.path.join(fake_dir, "responses.json")):
    with open(os.path.join(fake_dir, "responses.json")) as f:
        rules = json.load(f)


for rule in rules:
    if all(m in joined or m in stdin for m in rule.get("match", [])):
        if "run" in rule:
            subprocess.run(rule["run"], check=True)
        time.sleep(rule.get("sleep", 0))
        if "raw" in rule:
            emit(rule["raw"])
        elif "body" in rule:
            emit(json.dumps(rule["body"]))
        sys.stderr.write(rule.get("stderr", ""))
        sys.exit(rule.get("exit", 0))

sys.stderr.write("fake gh: no rule for: " + joined + "\n")
sys.exit(2)
