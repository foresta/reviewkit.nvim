{
  "schema": {
    "$defs": {
      "AgentType": {
        "enum": [
          "claude",
          "plain"
        ],
        "type": "string"
      },
      "Anchor": {
        "description": "Where the comment was made, kept so a later refresh can tell whether the\nline moved. `head_sha` is `null` on a working tree; `blob` pins it then.",
        "properties": {
          "base_sha": {
            "type": "string"
          },
          "blob": {
            "type": [
              "string",
              "null"
            ]
          },
          "context": {
            "$ref": "#/$defs/AnchorContext"
          },
          "head_sha": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "base_sha",
          "context"
        ],
        "type": "object"
      },
      "AnchorContext": {
        "properties": {
          "after": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "before": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "lines": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "before",
          "lines",
          "after"
        ],
        "type": "object"
      },
      "Check": {
        "properties": {
          "conclusion": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "status"
        ],
        "type": "object"
      },
      "Comment": {
        "properties": {
          "anchor": {
            "$ref": "#/$defs/Anchor"
          },
          "body": {
            "type": "string"
          },
          "commentable": {
            "$ref": "#/$defs/Commentable"
          },
          "created_at": {
            "type": "string"
          },
          "deliveries": {
            "default": [],
            "description": "Where this text already went. Cleared when the body or suggestion\nchanges: a delivery of the old text says nothing about the new one.",
            "items": {
              "$ref": "#/$defs/Delivery"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/CommentKind"
          },
          "last_error": {
            "anyOf": [
              {
                "$ref": "#/$defs/LastError"
              },
              {
                "type": "null"
              }
            ]
          },
          "line": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "reply_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "side": {
            "$ref": "#/$defs/Side"
          },
          "stale": {
            "type": "boolean"
          },
          "start_line": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "suggestion": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "side",
          "line",
          "kind",
          "body",
          "anchor",
          "stale",
          "commentable",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "CommentInput": {
        "properties": {
          "body": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/CommentKind",
            "default": "issue"
          },
          "line": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "reply_to": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "side": {
            "$ref": "#/$defs/Side"
          },
          "start_line": {
            "default": null,
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "suggestion": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path",
          "side",
          "line",
          "body"
        ],
        "type": "object"
      },
      "CommentKind": {
        "enum": [
          "issue",
          "suggestion",
          "question",
          "praise",
          "nit"
        ],
        "type": "string"
      },
      "CommentPatch": {
        "description": "Omitted = unchanged, `null` = cleared, value = set. Plain `Option` cannot\ntell omitted from `null`, so the clearable fields are `Option<Option<T>>`.",
        "properties": {
          "body": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "anyOf": [
              {
                "$ref": "#/$defs/CommentKind"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "line": {
            "default": null,
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "start_line": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "suggestion": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Commentable": {
        "description": "Whether GitHub would accept the comment; `reason` says why not\n(`outside_diff`, or `binary` / `too_large`, which are independent of the\nhost). The\nother reasons only appear in `Skipped`. Comments outside the diff are\nstill queued (D4); the sink decides what to skip.\nNamed after GitHub rather than a neutral `in_diff` because the ranges,\nthis flag and `outside_diff` all follow GitHub's rule; a second hosting\nsink needs per-destination ranges and reasons, a version bump anyway.",
        "properties": {
          "github": {
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "$ref": "#/$defs/Reason"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "github"
        ],
        "type": "object"
      },
      "CommentableRanges": {
        "description": "Closed 1-based line ranges, merged and clipped to the file, per side.",
        "properties": {
          "base": {
            "items": {
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": "array"
          },
          "head": {
            "items": {
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": "array"
          }
        },
        "required": [
          "base",
          "head"
        ],
        "type": "object"
      },
      "Decision": {
        "properties": {
          "body": {
            "type": "string"
          },
          "deliveries": {
            "default": [],
            "description": "Where this decision went, like `Comment.deliveries`; a new decision\nstarts with none.",
            "items": {
              "$ref": "#/$defs/Delivery"
            },
            "type": "array"
          },
          "event": {
            "$ref": "#/$defs/DecisionEvent"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "event",
          "body",
          "updated_at"
        ],
        "type": "object"
      },
      "DecisionEvent": {
        "description": "1:1 with GitHub's PullRequestReviewEvent, lowercased.",
        "enum": [
          "approve",
          "request_changes",
          "comment"
        ],
        "type": "string"
      },
      "DecisionInput": {
        "description": "stdin of `decision set`; core adds `updated_at`.",
        "properties": {
          "body": {
            "default": "",
            "type": "string"
          },
          "event": {
            "$ref": "#/$defs/DecisionEvent"
          }
        },
        "required": [
          "event"
        ],
        "type": "object"
      },
      "DecisionStatus": {
        "enum": [
          "sent",
          "failed",
          "skipped",
          "not_applicable"
        ],
        "type": "string"
      },
      "Delivery": {
        "properties": {
          "at": {
            "type": "string"
          },
          "consumed": {
            "default": false,
            "description": "This delivery took the comment out of the queue. When the sink is the\nsession's final destination the comment is not put back (an edit\nwould deliver it twice); the history drops these first.",
            "type": "boolean"
          },
          "mode": {
            "$ref": "#/$defs/DeliveryMode"
          },
          "sink": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "sink",
          "at",
          "mode"
        ],
        "type": "object"
      },
      "DeliveryMode": {
        "description": "`staged` text was only typed into an agent's input and may be thrown\naway there; `copied` only reached a register. Neither consumes a comment.",
        "enum": [
          "sent",
          "staged",
          "copied"
        ],
        "type": "string"
      },
      "Error": {
        "properties": {
          "code": {
            "$ref": "#/$defs/ErrorCode"
          },
          "details": {
            "default": {},
            "description": "Always an object, so callers can index it without a null check."
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "default": false,
            "type": "boolean"
          },
          "tool": {
            "description": "The external tool that failed (\"gh\", \"herdr\"), for the tool codes.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "From the first release on, codes are only ever added, never renamed.\nThey name what went wrong, not which tool: `Error.tool` says that, so a\nnew sink or source adds no codes. The aliases read states saved before\nthe codes were generic. No per-variant docs: they would turn the JSON\nSchema into a `oneOf` instead of one `enum` list.",
        "enum": [
          "E_USAGE",
          "E_INVALID",
          "E_NOT_COMMENTABLE",
          "E_NO_SESSION",
          "E_NO_COMMENT",
          "E_NO_TARGET",
          "E_NO_THREAD",
          "E_GIT",
          "E_TOOL",
          "E_TOOL_MISSING",
          "E_AUTH",
          "E_PENDING_REVIEW",
          "E_AMBIGUOUS",
          "E_CONFLICT",
          "E_LOCKED",
          "E_SCHEMA_VERSION",
          "E_INTERNAL",
          "E_IO"
        ],
        "type": "string"
      },
      "Etags": {
        "description": "One hash per section, so a client can tell which sections changed\nwithout diffing the whole session.",
        "properties": {
          "comments": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "targets": {
            "type": "string"
          },
          "thread_actions": {
            "type": "string"
          },
          "threads": {
            "type": "string"
          },
          "viewed": {
            "type": "string"
          }
        },
        "required": [
          "targets",
          "comments",
          "decision",
          "threads",
          "thread_actions",
          "viewed"
        ],
        "type": "object"
      },
      "Failed": {
        "description": "`comment_id` is `null` when the whole review failed rather than one comment.",
        "properties": {
          "comment_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "$ref": "#/$defs/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "GithubOptions": {
        "type": "object"
      },
      "HeadRef": {
        "properties": {
          "dirty": {
            "type": "boolean"
          },
          "ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha": {
            "description": "`null` for a working tree: there is no commit to pin, comments anchor\nto blobs instead.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "dirty"
        ],
        "type": "object"
      },
      "HealthInfo": {
        "properties": {
          "gh_auth": {
            "description": "`null` rather than `false` when gh is missing, so \"not installed\" and\n\"not logged in\" stay distinguishable.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "state_dir": {
            "$ref": "#/$defs/StateDirStatus"
          },
          "tools": {
            "$ref": "#/$defs/ToolsStatus"
          }
        },
        "required": [
          "tools",
          "state_dir"
        ],
        "type": "object"
      },
      "HerdrOptions": {
        "properties": {
          "agent_type": {
            "anyOf": [
              {
                "$ref": "#/$defs/AgentType"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "header": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "match_foreground_cwd": {
            "default": null,
            "type": [
              "boolean",
              "null"
            ]
          },
          "stage": {
            "default": null,
            "description": "Puts the text in the agent's input without pressing Enter (not git\nstaging); the agent's user submits or discards it.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "target": {
            "default": null,
            "description": "A pane id (`SinkTarget.id`); without it the pane is found by cwd.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Hunk": {
        "description": "Zero-context hunk. When a count is 0 the start is the line *before* the\nchange, exactly as git prints it (0 means before the first line).",
        "properties": {
          "base_count": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "base_start": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "head_count": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "head_start": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "base_start",
          "base_count",
          "head_start",
          "head_count"
        ],
        "type": "object"
      },
      "LastError": {
        "properties": {
          "at": {
            "type": "string"
          },
          "code": {
            "$ref": "#/$defs/ErrorCode"
          },
          "message": {
            "type": "string"
          },
          "sink": {
            "type": "string"
          }
        },
        "required": [
          "sink",
          "code",
          "message",
          "at"
        ],
        "type": "object"
      },
      "LastSubmit": {
        "properties": {
          "at": {
            "type": "string"
          },
          "result": {
            "$ref": "#/$defs/SinkResult"
          },
          "sink": {
            "type": "string"
          }
        },
        "required": [
          "sink",
          "at",
          "result"
        ],
        "type": "object"
      },
      "PrInfo": {
        "description": "Kept in `pr.json`, not in the session, so the envelope stays small.",
        "properties": {
          "author": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "checks": {
            "items": {
              "$ref": "#/$defs/Check"
            },
            "type": "array"
          },
          "created_at": {
            "type": "string"
          },
          "fetched_at": {
            "type": "string"
          },
          "timeline": {
            "items": {
              "$ref": "#/$defs/TimelineItem"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "body",
          "author",
          "url",
          "created_at",
          "updated_at",
          "timeline",
          "checks",
          "fetched_at"
        ],
        "type": "object"
      },
      "PrState": {
        "description": "GitHub's own spelling, so sink-github passes it through unchanged.",
        "enum": [
          "OPEN",
          "CLOSED",
          "MERGED"
        ],
        "type": "string"
      },
      "PreviewReply": {
        "properties": {
          "comment_id": {
            "type": "string"
          },
          "thread_id": {
            "type": "string"
          }
        },
        "required": [
          "comment_id",
          "thread_id"
        ],
        "type": "object"
      },
      "Range": {
        "properties": {
          "end": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "start": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "type": "object"
      },
      "Reason": {
        "enum": [
          "outside_diff",
          "stale",
          "binary",
          "not_supported",
          "delivered",
          "too_large"
        ],
        "type": "string"
      },
      "Repo": {
        "properties": {
          "host": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "remote_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "root": {
            "type": "string"
          }
        },
        "required": [
          "root"
        ],
        "type": "object"
      },
      "RevRef": {
        "properties": {
          "ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha": {
            "type": "string"
          }
        },
        "required": [
          "sha"
        ],
        "type": "object"
      },
      "SendStatus": {
        "enum": [
          "sent",
          "failed"
        ],
        "type": "string"
      },
      "Sent": {
        "properties": {
          "comment_id": {
            "type": "string"
          },
          "remote_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "description": "The comment's `updated_at` when its text was handed to the sink. A\ncomment edited since then was not what got delivered.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "comment_id"
        ],
        "type": "object"
      },
      "Session": {
        "properties": {
          "base": {
            "$ref": "#/$defs/RevRef"
          },
          "comments": {
            "items": {
              "$ref": "#/$defs/Comment"
            },
            "type": "array"
          },
          "created_at": {
            "type": "string"
          },
          "decision": {
            "anyOf": [
              {
                "$ref": "#/$defs/Decision"
              },
              {
                "type": "null"
              }
            ]
          },
          "etags": {
            "$ref": "#/$defs/Etags"
          },
          "head": {
            "$ref": "#/$defs/HeadRef"
          },
          "history": {
            "default": [],
            "description": "Comments that left the queue, with their deliveries, so a consumed\ncomment can still be looked up instead of being gone. Always empty in\na response, which would otherwise grow with every send; read it with\n`history list`.",
            "items": {
              "$ref": "#/$defs/Comment"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "last_submit": {
            "anyOf": [
              {
                "$ref": "#/$defs/LastSubmit"
              },
              {
                "type": "null"
              }
            ]
          },
          "pending_apply": {
            "default": false,
            "description": "A client sink's delivery waiting for the session lock to be recorded;\nderived like `pending_submit`.",
            "type": "boolean"
          },
          "pending_submit": {
            "default": false,
            "description": "Derived from the state dir on every read rather than stored: a crash\nbetween sending and saving is exactly when the stored value is wrong.",
            "type": "boolean"
          },
          "repo": {
            "$ref": "#/$defs/Repo"
          },
          "rev": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "schema_version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "source": {
            "$ref": "#/$defs/Source"
          },
          "state_path": {
            "type": "string"
          },
          "targets": {
            "items": {
              "$ref": "#/$defs/Target"
            },
            "type": "array"
          },
          "thread_actions": {
            "items": {
              "$ref": "#/$defs/ThreadAction"
            },
            "type": "array"
          },
          "threads": {
            "items": {
              "$ref": "#/$defs/Thread"
            },
            "type": "array"
          },
          "updated_at": {
            "type": "string"
          },
          "viewed": {
            "additionalProperties": {
              "$ref": "#/$defs/Viewed"
            },
            "description": "Keyed by path. A `BTreeMap` so the JSON (and therefore the etag) has a\nstable key order.",
            "type": "object"
          }
        },
        "required": [
          "schema_version",
          "id",
          "rev",
          "state_path",
          "repo",
          "source",
          "base",
          "head",
          "targets",
          "comments",
          "threads",
          "thread_actions",
          "viewed",
          "etags",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "SessionSummary": {
        "properties": {
          "comments": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "decision": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "repo_root": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
